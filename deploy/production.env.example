# Do not use this file as a password store. Put the values in Portainer
# Stack environment variables or a managed secret store.
POSTGRES_DB=serviceops
POSTGRES_USER=serviceops_app
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql+psycopg://serviceops_app:URL_ENCODED_PASSWORD@postgres:5432/serviceops
PUBLIC_ORIGIN=https://support.example.com
TLS_CERT_PATH=/opt/serviceops/tls/fullchain.pem
TLS_KEY_PATH=/opt/serviceops/tls/privkey.pem
# Optional for a controlled model runtime:
# MODEL_API_KEY=replace-with-a-server-side-key
