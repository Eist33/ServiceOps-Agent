APP_ENV=development
DATABASE_URL=postgresql+psycopg://serviceops:serviceops@localhost:5432/serviceops
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DEMO_MODE_ENABLED=true
API_DOCS_ENABLED=true
SENSITIVE_TRACING_ENABLED=false

AGENT_MODE=deterministic
MODEL_PROVIDER=deepseek
MODEL_API_STYLE=responses
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=1
MODEL_REQUESTS_PER_MINUTE=30
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN_SECONDS=60
MODEL_FALLBACK_ENABLED=true
MODEL_MAX_TURNS=8

# Legacy OpenAI mode remains available during migration.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
SENSITIVE_TRACING_ENABLED=false
